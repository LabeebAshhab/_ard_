# ---- Application database (the 6 ARD tables) ----
ARD_DB_HOST=localhost
ARD_DB_PORT=5432
ARD_DB_NAME=ard
ARD_DB_USER=ard
ARD_DB_PASSWORD=ard_pass

# ---- Scheduler ----
# Handwritten note: the program checks SCHEDULE every 30 minutes.
POLL_INTERVAL_MINUTES=30
# Timezone used for schedule matching and for the timestamps in EXECUTION_LOG.
APP_TIMEZONE=Asia/Dhaka
OUTPUT_DIR=output
LOG_DIR=logs

# ---- Source databases the queries run against (QUERY.db_target) ----
# Format: name=postgresql://user:pass@host:port/dbname , comma separated.
# Any db_target not listed here falls back to the application database.
SOURCE_DB_TARGETS=core_db=postgresql://ard:ard_pass@localhost:5432/ard,reporting_db=postgresql://ard:ard_pass@localhost:5432/ard

# ---- SMTP ----
# DRY_RUN=true writes the .eml to LOG_DIR instead of sending. Use it for testing.
SMTP_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=ard-bot@example.com
